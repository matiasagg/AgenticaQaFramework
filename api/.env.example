# QA SaaS Platform - Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/qa_saas_db?schema=public"

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Gemini Configuration (único proveedor de IA)
# Clave global de fallback. Cada usuario también puede configurar su propia
# clave BYO (Bring Your Own) en la sección Settings de la aplicación web.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# AWS S3 Configuration (for evidence storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=qa-saas-evidence-storage

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# GitHub Integration (optional)
GITHUB_TOKEN=your-github-personal-access-token

# Jira Integration (optional)
JIRA_HOST=your-domain.atlassian.net
JIRA_EMAIL=your-jira-email
JIRA_API_TOKEN=your-jira-api-token
